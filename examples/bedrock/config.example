# AWS Bedrock Configuration Example
# Copy these environment variables to your shell or .env file

# Required: AWS Region where Bedrock is available
export AWS_REGION=us-east-1

# Optional: AWS Profile to use (if you have multiple AWS accounts)
# export AWS_PROFILE=your-profile-name

# Optional: Specific model to use
# export MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Optional: Model temperature (0.0 = deterministic, 1.0 = creative)
# export TEMPERATURE=0.0

# Note: AWS credentials should be configured separately via:
# 1. AWS CLI: aws configure
# 2. Environment variables: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
# 3. IAM roles (if running on AWS infrastructure)
